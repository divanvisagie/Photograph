MimeType=image/jpeg;image/png;image/tiff;image/webp;image/bmp;image/heic;image/avif;image/x-adobe-dng;image/x-fuji-raf;image/x-nikon-nef;image/x-canon-cr2;image/x-canon-cr3;image/x-sony-arw;
