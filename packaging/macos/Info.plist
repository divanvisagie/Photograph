<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for Photograph.app; build-dmg.sh fills in @VERSION@. -->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Photograph</string>
	<key>CFBundleDisplayName</key>
	<string>Photograph</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.divanvisagie.photograph</string>
	<key>CFBundleExecutable</key>
	<string>photograph</string>
	<key>CFBundleIconFile</key>
	<string>photograph</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.photography</string>
	<!-- Open With: the image types Photograph reads. Alternate rank, so it is
	     offered without taking over another app's default. Raw files are
	     public.camera-raw-image (DNG is com.adobe.raw-image). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.jpeg</string>
				<string>public.png</string>
				<string>public.tiff</string>
				<string>org.webmproject.webp</string>
				<string>com.microsoft.bmp</string>
				<string>public.heic</string>
				<string>public.avif</string>
				<string>public.camera-raw-image</string>
				<string>com.adobe.raw-image</string>
			</array>
		</dict>
	</array>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>GPL-2.0-only</string>
</dict>
</plist>
